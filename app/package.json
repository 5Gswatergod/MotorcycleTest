    "check:data": "python scripts/build_question_bank.py --check",
    "audit:data": "python scripts/audit_question_bank.py",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
